---
// The main download button with a strip of label tape stuck on its corner: how many times Fettle was
// downloaded. The share Worker fills the tape in with GitHub's own total (worker/src/downloads.ts);
// served without the Worker, or when GitHub doesn't answer, it stays hidden.
import type { Locale } from "../i18n/paths.ts";
import { t } from "../i18n/strings.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<span class="dl-cta"><slot /><span class="dl-tape" data-download-count data-locale={locale} data-one={t(locale, "downloads.one")} data-many={t(locale, "downloads.many")} hidden></span></span>
