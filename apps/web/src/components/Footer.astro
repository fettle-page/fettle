---
// The footer is the last slip off the roll: torn edge on top, small print in mono.
import { Wordmark } from "@fettle/receipt-ui";
import { alternates, localePath, type Locale } from "../i18n/paths.ts";
import { t } from "../i18n/strings.ts";
import { links, release } from "../release.ts";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const to = (p: string) => localePath(locale, p);
const year = new Date().getFullYear();
/** Each language in its own words, as language pickers do. */
const LANGUAGE_NAMES: Record<Locale, string> = { en: "English", it: "Italiano" };
const { source } = links(release);
---

<footer class="foot">
  <div class="foot-slip">
    <div class="foot-brand">
      <Wordmark className="foot-wordmark" />
      <p>{t(locale, "footer.tagline")}</p>
    </div>
    <nav class="foot-links" aria-label={t(locale, "footer.links")}>
      <a href={to("/faq")}>{t(locale, "nav.faq")}</a>
      <a href={to("/guides")}>{t(locale, "footer.guides")}</a>
      <a href={to("/privacy")}>{t(locale, "nav.privacy")}</a>
      <a href={to("/changelog")}>{t(locale, "footer.changelog")}</a>
      <a href={to("/download")}>{t(locale, "nav.download")}</a>
      <a href={to("/code-signing")}>{t(locale, "footer.signing")}</a>
      {source && <a href={source}>{t(locale, "footer.source")}</a>}
    </nav>
    <div class="foot-prefs">
      <fieldset class="foot-theme" data-theme-picker hidden>
        {/* The legend names the group for screen readers; the row shows the label (WebKit draws a floated legend above it). */}
        <legend class="sr-only">{t(locale, "theme.label")}</legend>
        <div class="foot-theme-row"><span class="foot-theme-label" aria-hidden="true">{t(locale, "theme.label")}</span><div class="foot-theme-options">
          {(["auto", "light", "dark", "oled"] as const).map((v) => (
            <label><input class="sr-only" type="radio" name="theme" value={v} /><span class={`swatch swatch-${v}`} aria-hidden="true"></span>{t(locale, `theme.${v}`)}</label>
          ))}
        </div></div>
      </fieldset>
      <nav class="foot-lang" aria-labelledby="foot-lang-label">
        <span id="foot-lang-label" class="foot-lang-label">{t(locale, "footer.language")}</span>
        {(["en", "it"] as const).map((l) => (
          <a href={alternates(path)[l]} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>{LANGUAGE_NAMES[l]}</a>
        ))}
      </nav>
    </div>
    <p class="foot-small">{t(locale, "footer.small")}</p>
    <p class="foot-small">© {year} Fettle&nbsp;· {t(locale, "footer.made")}</p>
  </div>
</footer>
