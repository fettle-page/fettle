---
// The rest of the questions, as links into the FAQ page (which opens the answer it lands on).
import { PRINTED_QUESTIONS, faqs } from "../content/faq.ts";
import type { Locale } from "../i18n/paths.ts";
import { localePath } from "../i18n/paths.ts";
import { home } from "../i18n/home.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = home(locale);
const faq = localePath(locale, "/faq");
const rest = faqs(locale).filter((f) => !PRINTED_QUESTIONS.includes(f.id));
---

<nav class="slip more-slip" aria-labelledby="more-title">
  <p class="slip-head" id="more-title">{h.moreHead}</p>
  <ul role="list">
    {rest.map((f) => (
      <li><a href={`${faq}#${f.id}`}>{f.q}</a></li>
    ))}
  </ul>
  <a class="more-all" href={faq}>{h.faqMore}&nbsp;→</a>
</nav>
