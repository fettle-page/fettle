---
import Doc from "../components/Doc.astro";
import { checkChangelog, releases } from "../content/changelog.ts";
import { pages } from "../i18n/pages.ts";
import type { Locale } from "../i18n/paths.ts";
import Base from "../layouts/Base.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = pages(locale).changelog;
// A mistyped date fails the build with a plain message, not Date's bare "Invalid time value".
checkChangelog(releases);
// Only dated entries are out; the next one's notes can wait here undated.
const out = releases.filter((r): r is typeof r & { date: string } => r.date !== null);
const day = new Intl.DateTimeFormat(locale === "it" ? "it-IT" : "en-GB", { dateStyle: "long", timeZone: "UTC" });
---

<Base locale={locale} path="/changelog" title={c.title} description={c.description}>
  <Doc kicker={c.kicker} title={c.h1}>
    <div class="prose">
      {out.length === 0 && <p>{c.empty}</p>}
      {
        out.map((r) => (
          <section>
            <h2>
              {r.version} <time datetime={r.date}>{day.format(new Date(r.date))}</time>
            </h2>
            <ul>
              {r.notes[locale].map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Doc>
</Base>
