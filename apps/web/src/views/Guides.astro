---
// The guides page: every guide (content/guides.ts), by name and a one-line summary.
import Doc from "../components/Doc.astro";
import { guides, guidesPage } from "../content/guides.ts";
import { localePath, type Locale } from "../i18n/paths.ts";
import Base from "../layouts/Base.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = guidesPage[locale];
---

<Base locale={locale} path="/guides" title={c.title} description={c.description}>
  <Doc kicker={c.kicker} title={c.h1} intro={c.intro}>
    <article class="prose">
      <ul class="guide-list">
        {
          guides.map((g) => (
            <li>
              <a href={localePath(locale, `/guides/${g.slug}`)}>{g[locale].h1}</a>
              <p>{g[locale].summary}</p>
            </li>
          ))
        }
      </ul>
    </article>
  </Doc>
</Base>
