// Fettle's window: the "Workbench" layout, drawn by Slint under Windows' own title bar. Mat with the printer slot on the left, side panel on the right.
import { ScrollView, Palette } from "std-widgets.slint";
import "fonts/bricolage-display-800.ttf";
import "fonts/bricolage-text-500.ttf";
import "fonts/bricolage-text-800.ttf";
import "fonts/fettle-mono-400.ttf";
import "fonts/fettle-mono-600.ttf";
import { Theme, Copy } from "theme.slint";
import { Row, Group, Line, Section, ReceiptData, BlankSection } from "data.slint";
import { Receipt, BlankReceipt, Wordmark } from "receipt.slint";
import { Icon, PrimaryButton, Button, HomePanel, CheckingPanel, Progress, ResultPanel, SettingsPanel, Focusable } from "panels.slint";
import { ShareView, LinksView, LinkRow } from "views.slint";

export { Theme, Copy }

export struct Hint { keys: string, label: string }

// The printer's mouth near the top of the mat, whole and lit from above: the receipt hangs from
// its slit and feeds out of it.
component Slot inherits Rectangle {
    in property <bool> ready;
    // How far down the slit is, from the mouth's top.
    out property <length> slit: self.height - 9px;
    height: 24px;
    border-radius: 12px;
    background: @linear-gradient(180deg, #3A3A36 0%, #1C1C1A 55%, #121211 100%);
    drop-shadow-offset-y: 6px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000.with-alpha(0.45);
    // A soft highlight along the top edge.
    Rectangle {
        x: 12px;
        y: 1px;
        width: parent.width - 24px;
        height: 1px;
        background: #FFFFFF.with-alpha(0.10);
    }
    Rectangle {
        x: 18px;
        y: root.slit;
        width: parent.width - 36px;
        height: 3px;
        border-radius: 2px;
        background: #000000;
    }
    if ready: HorizontalLayout {
        x: parent.width - self.preferred-width - 22px;
        y: 4px;
        height: 9px;
        spacing: 6px;
        Rectangle {
            width: 5px;
            Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: #5FD08F;
                drop-shadow-blur: 6px;
                drop-shadow-color: #5FD08F;
            }
        }
        Text {
            text: Copy.tr("mat.ready", Copy.lang).to-uppercase();
            font-family: Theme.mono;
            font-size: 8px;
            font-weight: 600;
            letter-spacing: 1.9px;
            color: #EDEBE4.with-alpha(0.55);
            vertical-alignment: center;
        }
    }
}

// "Last check · yesterday": a paper label on the mat beside the faded receipt, never over its lines.
component MatLabel inherits Rectangle {
    in property <string> top-line;
    in property <string> bottom-line;
    // The mat's width beside the receipt: the label wraps rather than reach the paper or the edge.
    in property <length> room;
    width: min(col.preferred-width, room);
    height: col.preferred-height;
    accessible-role: text;
    accessible-label: top-line + " · " + bottom-line;
    Rectangle {
        transform-rotation: 2deg;
        background: Theme.paper;
        border-radius: 3px;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 7px;
        drop-shadow-color: #000000.with-alpha(0.2);
        col := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 9px;
            padding-left: 11px;
            padding-right: 11px;
            spacing: 3px;
            Text {
                text: root.top-line.to-uppercase();
                font-family: Theme.mono;
                font-size: 9.5px;
                font-weight: 600;
                letter-spacing: 1.4px;
                color: Theme.ink-soft;
                wrap: word-wrap;
            }
            Text {
                text: root.bottom-line.to-uppercase();
                font-family: Theme.mono;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1px;
                color: Theme.ink;
                wrap: word-wrap;
            }
        }
    }
}

// Why a check didn't finish, announced as soon as it shows.
component Alert inherits Text {
    font-family: Theme.mono;
    font-size: 14px;
    font-weight: 600;
    color: Theme.accent;
    wrap: word-wrap;
    accessible-role: text;
    accessible-label: self.text;
    accessible-live-region: assertive;
}

export component AppWindow inherits Window {
    title: "Fettle";
    icon: @image-url("img/icon.png");
    preferred-width: 1240px;
    preferred-height: 720px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.chrome;
    default-font-family: Theme.text;

    // What the mat shows: "blank" (first time and during a check), "live" (this check's receipt)
    // or "last" (the last receipt, faded).
    in property <string> mat: "blank";
    // What the side panel shows: "home", "checking", "result" or "settings".
    in-out property <string> view: "home";
    in property <ReceiptData> receipt;
    in property <bool> printed: true;
    in property <bool> open-all;
    in-out property <length> mat-scroll;
    // The receipt feeds down out of the slot when it arrives.
    in property <bool> fed: true;
    in property <bool> feeding;
    in property <[Row]> blank-machine;
    in property <[BlankSection]> blank-sections;
    in property <[Progress]> progress;
    in property <string> progress-count;
    in property <string> back-title;
    in property <string> back-body;
    in property <string> last-top;
    in property <string> last-bottom;
    in property <bool> deep;
    in property <string> deep-problem;
    in property <bool> deep-asking;
    in property <string> answer;
    in property <[Section]> numbers;
    in property <[string]> status-items;
    in property <[Hint]> hints;
    in property <string> dock-status;
    // The print preview: the pages as they'll print, "2 pages · A4", and whether Windows can print
    // here (otherwise its button saves a PDF).
    in property <[image]> preview-pages;
    in property <string> preview-label;
    in property <bool> preview-printing: true;
    callback print-confirmed();
    // A newer version: what to say, and the Download link's name for screen readers.
    in property <string> update-text;
    in property <string> update-label;
    callback open-update();
    // Why the last check didn't finish, on the first screen.
    in property <string> alert;
    in property <string> lang-choice: "auto";
    in property <string> theme-choice: "system";
    in property <bool> remember: true;
    in property <bool> show-private;
    in property <bool> updates: true;
    in property <string> update-every: "daily";
    callback update-every-chosen(string);
    in property <string> version;
    in property <bool> private-shown;
    in property <[Row]> private-rows;
    // Share: editing, sending, done or failed; and the links this PC can still delete.
    in property <string> share-status: "editing";
    in property <string> share-problem;
    in property <string> share-json;
    in property <string> share-link;
    in property <string> share-delete-link;
    in property <string> share-expires;
    in property <string> share-note;
    in property <[LinkRow]> links;
    in property <string> links-status;
    in property <bool> links-failed;
    in property <bool> links-busy;
    // "Shared links · 2", for screen readers (the header shows an icon and the count).
    in property <string> links-label;
    // What the Share view's choices hold while it's open (reset each time it opens).
    in-out property <string> share-expiry: "30d";
    in-out property <bool> share-locked;
    in-out property <string> share-password;
    property <bool> in-view: view == "settings" || view == "share" || view == "links" || view == "preview";

    callback check();
    callback run-deep();
    callback print-asked();
    callback save-asked();
    callback copy-asked();
    callback lang-chosen(string);
    callback theme-chosen(string);
    callback remember-toggled(bool);
    callback private-toggled(bool);
    callback updates-toggled(bool);
    callback open-settings();
    callback open-share();
    callback open-links();
    callback create-link(string, bool, string);
    callback copy-link();
    callback copy-delete-link();
    // The new link as a QR code (a path in a square of this many modules) and, if it's locked, a note.
    in property <string> share-qr;
    in property <int> share-qr-size: 1;
    in property <string> share-locked-note;
    callback open-link();
    callback delete-link(string);
    callback back();
    // The window's shortcuts listen from the start; a view that closes hands the keyboard back.
    init => {
        keys.focus();
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed view => {
        if !in-view {
            keys.focus();
        }
        // A new Share view starts from the defaults; a typed password never outlives the view.
        if view != "share" {
            share-password = "";
            share-locked = false;
            share-expiry = "30d";
        }
    }
    callback theme-changed(bool, bool);

    changed dark => {
        theme-changed(Theme.dark, Theme.oled);
        // Slint's own widgets and its badge follow Fettle's theme.
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    out property <bool> dark: Theme.dark || Theme.oled;

    keys := FocusScope {
        KeyBinding {
            keys: @keys(Return);
            enabled: root.view == "home" || root.view == "result";
            activated => {
                root.check();
            }
        }
        KeyBinding {
            keys: @keys(Control + R);
            enabled: root.view == "result";
            activated => {
                root.check();
            }
        }
        KeyBinding {
            keys: @keys(Control + P);
            // From the receipt it opens the preview; in the preview it prints.
            enabled: root.view == "result" || root.view == "preview";
            activated => {
                if root.view == "preview" {
                    root.print-confirmed();
                } else {
                    root.print-asked();
                }
            }
        }
        KeyBinding {
            keys: @keys(Control + S);
            enabled: root.view == "result";
            activated => {
                root.save-asked();
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            enabled: root.in-view;
            activated => {
                root.back();
            }
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;
                // The cutting mat: 1 cm grid, 5 cm major lines, lit from the top left.
                mat := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    background: Theme.mat-deep;
                    // The mat itself (light and grid) is drawn once and reused while things move
                    // over it: it only changes with the window's size or the theme.
                    Rectangle {
                        cache-rendering-hint: true;
                        clip: true;
                        Rectangle {
                            x: parent.width * 0.3 - self.width / 2;
                            y: parent.height * 0.2 - self.height / 2;
                            width: max(parent.width, parent.height) * 2.2;
                            height: self.width;
                            background: @radial-gradient(circle, Theme.mat 0%, Theme.mat 36%, Theme.mat-deep 100%);
                        }
                        // 1 cm lines every 38 px, a stronger line every 5 cm.
                        for i in Math.ceil(parent.width / 38px): Rectangle {
                            x: i * 38px;
                            width: 1px;
                            background: Math.mod(i, 5) == 0 ? Theme.mat-line : Theme.mat-line.with-alpha(Theme.mat-line.to-hsv().alpha * 0.46);
                        }
                        for i in Math.ceil(parent.height / 38px): Rectangle {
                            y: i * 38px;
                            height: 1px;
                            background: Math.mod(i, 5) == 0 ? Theme.mat-line : Theme.mat-line.with-alpha(Theme.mat-line.to-hsv().alpha * 0.46);
                        }
                    }
                    // The printer, behind the paper: the receipt comes out of its slit and lies over
                    // its front lip.
                    slot := Slot {
                        visible: root.view != "preview";
                        x: (parent.width - self.width) / 2;
                        y: 12px;
                        width: min(440px, parent.width - 32px);
                        ready: root.view != "checking";
                    }
                    // The receipt scrolls below the slit only: it never shows above the printer.
                    scroll := ScrollView {
                        visible: root.view != "preview";
                        y: slot.y + slot.slit + 1.5px;
                        height: parent.height - self.y;
                        content-y <=> root.mat-scroll;
                        content-width: self.visible-width;
                        content-height: paper-box.height + 41px;
                        paper-box := Rectangle {
                            x: (scroll.visible-width - 372px) / 2;
                            // The paper's torn top (7 px) stays up in the slit: it's still in the printer.
                            y: -7px;
                            width: 372px;
                            height: root.mat == "blank" ? blank.height : sheet.height;
                            blank := BlankReceipt {
                                visible: root.mat == "blank";
                                machine: root.blank-machine;
                                sections: root.blank-sections;
                            }
                            Rectangle {
                                visible: root.mat != "blank";
                                y: root.fed ? 0 : -parent.height - 20px;
                                height: sheet.height;
                                animate y {
                                    duration: root.feeding ? 700ms : 0ms;
                                    easing: cubic-bezier(0.22, 0.8, 0.3, 1);
                                }
                                sheet := Receipt {
                                    data: root.receipt;
                                    printed: root.printed;
                                    faded: root.mat == "last";
                                    open-all: root.open-all;
                                }
                            }
                        }
                    }
                    // Where the paper leaves the slit, a little in its shadow.
                    Rectangle {
                        visible: root.view != "preview";
                        x: scroll.x + (scroll.visible-width - 372px) / 2;
                        y: scroll.y;
                        width: 372px;
                        height: 10px;
                        background: @linear-gradient(180deg, #000000.with-alpha(0.22) 0%, #000000.with-alpha(0) 100%);
                    }
                    // The print preview: the pages as they'll print, on the mat in place of the receipt.
                    if root.view == "preview": preview-scroll := ScrollView {
                        content-width: self.visible-width;
                        content-height: pages-column.preferred-height;
                        pages-column := VerticalLayout {
                            width: preview-scroll.visible-width;
                            padding: 32px;
                            spacing: 24px;
                            alignment: start;
                            for page[i] in root.preview-pages: HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: min(520px, preview-scroll.visible-width - 64px);
                                    height: self.width * page.height / max(1, page.width);
                                    background: #FFFFFF;
                                    drop-shadow-offset-y: 6px;
                                    drop-shadow-blur: 18px;
                                    drop-shadow-color: #000000.with-alpha(0.25);
                                    Image {
                                        source: page;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: fill;
                                    }
                                }
                            }
                        }
                    }
                    // The old receipt's label lies on the mat, under the printer beside the paper: it
                    // stays put while the receipt scrolls.
                    if root.mat == "last" && root.view != "preview": MatLabel {
                        x: scroll.x + (scroll.visible-width + 372px) / 2 + 16px;
                        y: slot.y + slot.height + 18px;
                        room: (scroll.visible-width - 372px) / 2 - 30px;
                        top-line: root.last-top;
                        bottom-line: root.last-bottom;
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.chrome-line;
                }
                // The side panel: a heading row, a body that scrolls, and the dock.
                Rectangle {
                    width: 372px;
                    background: Theme.chrome;
                    VerticalLayout {
                        HorizontalLayout {
                            height: 52px;
                            padding-left: root.in-view ? 16px : 26px;
                            padding-right: 14px;
                            spacing: 6px;
                            if !root.in-view: Rectangle {
                                width: 64px;
                                Wordmark {
                                    y: (parent.height - self.height) / 2;
                                    height: 17px;
                                    ink: Theme.chrome-ink;
                                }
                            }
                            if root.in-view: Button {
                                y: (parent.height - self.height) / 2;
                                horizontal-stretch: 0;
                                quiet: true;
                                // Opening a view puts the keyboard in it.
                                init => {
                                    self.take-focus();
                                }
                                text: Copy.tr("panel.back", Copy.lang);
                                icon: "M15 5 L8 12 L15 19";
                                clicked => {
                                    root.back();
                                }
                            }
                            Text {
                                text: root.view == "settings" ? Copy.tr("title.settings", Copy.lang) : root.view == "share" ? Copy.tr("share.title", Copy.lang) : root.view == "links" ? Copy.tr("links.title", Copy.lang) : root.view == "preview" ? Copy.tr("preview.title", Copy.lang) : Copy.tr("title.context", Copy.lang);
                                font-family: root.in-view ? Theme.display : Theme.mono;
                                font-size: root.in-view ? 18px : 12px;
                                font-weight: root.in-view ? 800 : 400;
                                color: root.in-view ? Theme.chrome-ink : Theme.chrome-soft;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if !root.in-view && root.view != "checking" && root.links.length > 0: Button {
                                y: (parent.height - self.height) / 2;
                                horizontal-stretch: 0;
                                quiet: true;
                                text: root.links.length;
                                label: root.links-label;
                                icon: "M10 14 C11.8 15.8 14.6 15.8 16.4 14 L19.4 11 C21.2 9.2 21.2 6.4 19.4 4.6 C17.6 2.8 14.8 2.8 13 4.6 L12 5.6 M14 10 C12.2 8.2 9.4 8.2 7.6 10 L4.6 13 C2.8 14.8 2.8 17.6 4.6 19.4 C6.4 21.2 9.2 21.2 11 19.4 L12 18.4";
                                clicked => {
                                    root.open-links();
                                }
                            }
                            if !root.in-view && root.view != "checking": Button {
                                y: (parent.height - self.height) / 2;
                                horizontal-stretch: 0;
                                quiet: true;
                                text: Copy.tr("title.settings", Copy.lang);
                                icon: "M15.2 12 A3.2 3.2 0 1 1 8.8 12 A3.2 3.2 0 1 1 15.2 12 Z M12 2.8 L12 5.2 M12 18.8 L12 21.2 M2.8 12 L5.2 12 M18.8 12 L21.2 12 M5.5 5.5 L7.2 7.2 M16.8 16.8 L18.5 18.5 M5.5 18.5 L7.2 16.8 M16.8 7.2 L18.5 5.5";
                                clicked => {
                                    root.open-settings();
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.chrome-line;
                        }
                        side-scroll := ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, body.preferred-height);
                            body := VerticalLayout {
                                width: side-scroll.visible-width;
                                padding-top: 24px;
                                padding-left: 26px;
                                padding-right: 26px;
                                padding-bottom: 12px;
                                alignment: start;
                                if root.view == "home": HomePanel {
                                    back-title: root.back-title;
                                    back-body: root.back-body;
                                }
                                if root.view == "home" && root.alert != "": Alert { text: root.alert; }
                                if root.view == "checking": CheckingPanel {
                                    sections: root.progress;
                                    count: root.progress-count;
                                }
                                // A failed re-check: the receipt stays, the problem shows above it.
                                if root.view == "result" && root.alert != "": VerticalLayout {
                                    padding-bottom: 18px;
                                    Alert { text: root.alert; }
                                }
                                if root.view == "result": ResultPanel {
                                    when: root.receipt.when;
                                    answer: root.answer;
                                    deep: root.deep;
                                    deep-problem: root.deep-problem;
                                    deep-asking: root.deep-asking;
                                    numbers: root.numbers;
                                    private-shown: root.private-shown;
                                    private-rows: root.private-rows;
                                    again => {
                                        root.check();
                                    }
                                    run-deep => {
                                        root.run-deep();
                                    }
                                }
                                if root.view == "share": ShareView {
                                    status: root.share-status;
                                    problem: root.share-problem;
                                    json: root.share-json;
                                    link: root.share-link;
                                    delete-link: root.share-delete-link;
                                    expires-text: root.share-expires;
                                    qr: root.share-qr;
                                    qr-size: root.share-qr-size;
                                    locked-note: root.share-locked-note;
                                    copy-link => {
                                        root.copy-link();
                                    }
                                    open-link => {
                                        root.open-link();
                                    }
                                    copy-delete-link => {
                                        root.copy-delete-link();
                                    }
                                    expiry <=> root.share-expiry;
                                    locked <=> root.share-locked;
                                    password <=> root.share-password;
                                }
                                if root.view == "links": LinksView {
                                    links: root.links;
                                    status: root.links-status;
                                    failed: root.links-failed;
                                    busy: root.links-busy;
                                    delete(id) => {
                                        root.delete-link(id);
                                    }
                                }
                                if root.view == "preview": VerticalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: root.preview-label;
                                        font-family: Theme.display;
                                        font-size: 22px;
                                        font-weight: 800;
                                        color: Theme.chrome-ink;
                                    }
                                    Text {
                                        text: Copy.tr("preview.note", Copy.lang);
                                        font-family: Theme.text;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: Theme.chrome-soft;
                                        wrap: word-wrap;
                                    }
                                    if !root.preview-printing: Text {
                                        text: Copy.tr("preview.no_printing", Copy.lang);
                                        font-family: Theme.mono;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.view == "settings": SettingsPanel {
                                    theme-choice: root.theme-choice;
                                    lang-choice: root.lang-choice;
                                    remember: root.remember;
                                    show-private: root.show-private;
                                    updates: root.updates;
                                    update-every: root.update-every;
                                    version: root.version;
                                    theme-chosen(v) => {
                                        root.theme-chosen(v);
                                    }
                                    lang-chosen(v) => {
                                        root.lang-chosen(v);
                                    }
                                    remember-toggled(v) => {
                                        root.remember-toggled(v);
                                    }
                                    private-toggled(v) => {
                                        root.private-toggled(v);
                                    }
                                    updates-toggled(v) => {
                                        root.updates-toggled(v);
                                    }
                                    update-every-chosen(v) => {
                                        root.update-every-chosen(v);
                                    }
                                }
                            }
                        }
                        if root.view == "home" || root.view == "result" || root.view == "share" || root.view == "preview": Rectangle {
                            height: 1px;
                            background: Theme.chrome-line;
                        }
                        if root.view == "share": VerticalLayout {
                            vertical-stretch: 0;
                            padding-top: 16px;
                            padding-left: 26px;
                            padding-right: 26px;
                            padding-bottom: 20px;
                            spacing: 10px;
                            if root.share-status != "done": PrimaryButton {
                                text: root.share-status == "sending" ? Copy.tr("share.sending", Copy.lang) : Copy.tr("share.create", Copy.lang);
                                enabled: root.share-status != "sending";
                                clicked => {
                                    root.create-link(root.share-expiry, root.share-locked, root.share-password);
                                }
                            }
                            if root.share-status == "done": PrimaryButton {
                                text: Copy.tr("share.finish", Copy.lang);
                                clicked => {
                                    root.back();
                                }
                            }
                            if root.share-note != "": Text {
                                text: root.share-note;
                                accessible-role: text;
                                accessible-label: root.share-note;
                                accessible-live-region: polite;
                                font-family: Theme.mono;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        if root.view == "preview": VerticalLayout {
                            vertical-stretch: 0;
                            padding-top: 16px;
                            padding-left: 26px;
                            padding-right: 26px;
                            padding-bottom: 20px;
                            PrimaryButton {
                                text: root.preview-printing ? Copy.tr("preview.print", Copy.lang) : Copy.tr("preview.save", Copy.lang);
                                clicked => {
                                    root.print-confirmed();
                                }
                            }
                        }
                        if root.view == "home": VerticalLayout {
                            vertical-stretch: 0;
                            padding-top: 16px;
                            padding-left: 26px;
                            padding-right: 26px;
                            padding-bottom: 20px;
                            spacing: 12px;
                            PrimaryButton {
                                text: root.back-title == "" ? Copy.tr("home.button", Copy.lang) : Copy.tr("scan.again", Copy.lang);
                                clicked => {
                                    root.check();
                                }
                            }
                            Text {
                                text: Copy.tr("dock.enter", Copy.lang);
                                font-family: Theme.mono;
                                font-size: 12px;
                                color: Theme.chrome-soft;
                                horizontal-alignment: center;
                            }
                        }
                        if root.view == "result": VerticalLayout {
                            vertical-stretch: 0;
                            padding-top: 16px;
                            padding-left: 26px;
                            padding-right: 26px;
                            padding-bottom: 20px;
                            spacing: 10px;
                            PrimaryButton {
                                text: Copy.tr("share.button", Copy.lang);
                                clicked => {
                                    root.open-share();
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    horizontal-stretch: 1;
                                    text: Copy.tr("export.print", Copy.lang);
                                    icon: "M7 9 L7 3 L17 3 L17 9 M7 17 L4 17 L4 9 L20 9 L20 17 L17 17 M7 14 L17 14 L17 21 L7 21 Z";
                                    clicked => {
                                        root.print-asked();
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: Copy.tr("export.json", Copy.lang);
                                    icon: "M12 4 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M5 20 L19 20";
                                    clicked => {
                                        root.save-asked();
                                    }
                                }
                                Button {
                                    horizontal-stretch: 1;
                                    text: Copy.tr("export.copy", Copy.lang);
                                    icon: "M9 9 L20 9 L20 20 L9 20 Z M5 15 L4 15 L4 4 L15 4 L15 5";
                                    clicked => {
                                        root.copy-asked();
                                    }
                                }
                            }
                            if root.dock-status != "": Text {
                                text: root.dock-status;
                                accessible-role: text;
                                accessible-label: root.dock-status;
                                accessible-live-region: polite;
                                font-family: Theme.mono;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            // The status bar: what happened on the left, shortcut hints on the right.
            Rectangle {
                height: 30px;
                background: Theme.chrome;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.chrome-line;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 22px;
                    for item in root.status-items: Text {
                        text: item;
                        font-family: Theme.mono;
                        font-size: 12px;
                        color: Theme.chrome-soft;
                        vertical-alignment: center;
                    }
                    if root.update-text != "": HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.update-text;
                            font-family: Theme.mono;
                            font-size: 12px;
                            color: Theme.chrome-ink;
                            vertical-alignment: center;
                            accessible-role: text;
                            accessible-label: root.update-text;
                            accessible-live-region: polite;
                        }
                        TouchArea {
                            width: get.preferred-width + 4px;
                            accessible-role: button;
                            accessible-label: root.update-label;
                            accessible-action-default => {
                                root.open-update();
                            }
                            clicked => {
                                root.open-update();
                            }
                            mouse-cursor: pointer;
                            update-focus := Focusable {
                                activate => {
                                    root.open-update();
                                }
                            }
                            if update-focus.ring: Rectangle {
                                border-radius: 3px;
                                border-width: 2px;
                                border-color: Theme.accent;
                            }
                            get := Text {
                                text: Copy.tr("update.get", Copy.lang);
                                font-family: Theme.mono;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    for h in root.hints: HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: key.preferred-width + 10px;
                            height: 20px;
                            y: 5px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.chrome-line;
                            background: Theme.chrome-card;
                            key := Text {
                                text: h.keys;
                                font-family: Theme.mono;
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.chrome-ink;
                            }
                        }
                        Text {
                            text: h.label;
                            font-family: Theme.mono;
                            font-size: 12px;
                            color: Theme.chrome-soft;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
