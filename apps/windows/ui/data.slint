// What the receipt shows, already in one language (receipt-ui's ReceiptModel, filled from Rust).
export struct Row { label: string, value: string }
export struct Group { title: string, rows: [Row] }
export struct Line {
    level: string,
    tag: string,
    headline: string,
    detail: string,
    action: string,
    // The line's place in the whole receipt, so lines print one after another.
    order: int,
}
export struct Section { id: string, title: string, tab: string, lines: [Line], details: [Group] }
// A row of "The numbers" tabs: each tab's label and its section's place in the list.
export struct TabRef { tab: string, index: int }
export struct TabRow { tabs: [TabRef] }
export struct ReceiptData {
    tone: string,
    when: string,
    summary: string,
    actions: [string],
    machine: [Row],
    sections: [Section],
    scan: string,
    footer: string,
    stamp: string,
    next-step: string,
    details-label: string,
}
// A section on the blank receipt: what it will look at, and whether its sources have finished.
export struct BlankSection { title: string, hint: string, done: bool }
// A saved check in My checks: its id (when it was made), its date and time, Quick or Deep, its
// summary line, and what a screen reader says for each of its controls.
export struct CheckRow { id: string, when: string, kind: string, summary: string, open-label: string, delete-label: string, tick-label: string }
// Before and after, on the mat: a changed value ("label · before → after") and whether it got
// "better", "worse" or neither ("neutral"), with the word to print beside it.
export struct SlipRow { label: string, before: string, after: string, change: string, word: string }
export struct SlipGroup { title: string, rows: [SlipRow] }
export struct SlipData {
    title: string,
    before-label: string,
    after-label: string,
    before: string,
    after: string,
    summary-before: string,
    summary-after: string,
    different-pc: string,
    nothing-changed: string,
    groups: [SlipGroup],
}
