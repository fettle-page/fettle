// The side panel's views opened from the header or the dock: Share this receipt, My shared links.
import { Theme, Copy } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Kicker, Button, Choice, Switch, Focusable } from "panels.slint";
import { Marks } from "receipt.slint";

export struct LinkRow { id: string, url: string, until: string }

component Body inherits Text {
    font-family: Theme.text;
    font-size: 14px;
    font-weight: 500;
    color: Theme.chrome-soft;
    wrap: word-wrap;
    line-height-factor: 1.25;
}

component Hint inherits Text {
    font-family: Theme.mono;
    font-size: 12.5px;
    color: Theme.chrome-soft;
    wrap: word-wrap;
}

component FieldLabel inherits Text {
    text: label.to-uppercase();
    in property <string> label;
    font-family: Theme.mono;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: Theme.chrome-soft;
}

// A one-line field: typed into (the password) or read-only and selectable (the links).
export component Field inherits Rectangle {
    in property <string> label;
    in property <bool> read-only;
    in property <bool> password;
    in-out property <string> text;
    height: 36px;
    border-radius: 5px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.chrome-line;
    background: Theme.chrome-card;
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        read-only: root.read-only;
        input-type: root.password ? InputType.password : InputType.text;
        single-line: true;
        vertical-alignment: center;
        font-family: Theme.mono;
        font-size: 13px;
        color: Theme.chrome-ink;
        selection-background-color: Theme.btn;
        selection-foreground-color: #FFFFFF;
        accessible-label: root.label;
        // Esc in a field belongs to the field: it shouldn't throw away what was typed.
        key-pressed(event) => {
            if event.text == Key.Escape {
                return accept;
            }
            reject
        }
    }
}

// A small button on the paper ticket: ink on paper in every theme.
component TicketButton inherits Rectangle {
    in property <string> text;
    in property <string> label;
    callback clicked();
    width: t.preferred-width + 26px;
    height: 32px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: focus.ring ? Theme.accent-ink : Theme.ink.with-alpha(0.55);
    background: touch.has-hover ? Theme.ink.with-alpha(0.06) : transparent;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-action-default => {
        root.clicked();
    }
    focus := Focusable {
        activate => {
            root.clicked();
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    t := Text {
        text: root.text;
        font-family: Theme.text;
        font-size: 13px;
        font-weight: 800;
        color: Theme.ink;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// "Share a link", in the side panel. The receipt on the mat is the preview; the exact JSON sits
// behind an advanced fold.
export component ShareView inherits VerticalLayout {
    // editing, sending, done or failed
    in property <string> status;
    in property <string> problem;
    in property <string> json;
    in property <string> link;
    in property <string> delete-link;
    in property <string> expires-text;
    // The link as a QR code (a path in a square of qr-size modules), and the lock note if it has one.
    in property <string> qr;
    in property <int> qr-size: 1;
    in property <string> locked-note;
    callback copy-link();
    callback open-link();
    callback copy-delete-link();
    in-out property <string> expiry;
    in-out property <bool> locked;
    in-out property <string> password;
    property <bool> show-json;
    spacing: 24px;
    if status != "done": VerticalLayout {
        spacing: 24px;
        Body { text: Copy.tr("share.intro", Copy.lang); }
        VerticalLayout {
            spacing: 10px;
            Kicker { text: Copy.tr("share.expiry", Copy.lang); }
            Choice {
                labels: [Copy.tr("share.7d", Copy.lang), Copy.tr("share.30d", Copy.lang), Copy.tr("share.1y", Copy.lang)];
                values: ["7d", "30d", "1y"];
                value: root.expiry;
                chose(v) => {
                    root.expiry = v;
                }
            }
        }
        VerticalLayout {
            spacing: 12px;
            Switch {
                text: Copy.tr("share.lock", Copy.lang);
                on: root.locked;
                toggled(v) => {
                    root.locked = v;
                }
            }
            if root.locked: VerticalLayout {
                spacing: 6px;
                FieldLabel { label: Copy.tr("share.password", Copy.lang); }
                Field {
                    label: Copy.tr("share.password", Copy.lang);
                    password: true;
                    text <=> root.password;
                }
                Hint { text: Copy.tr("share.password_note", Copy.lang); }
            }
        }
        VerticalLayout {
            spacing: 8px;
            TouchArea {
                height: 22px;
                accessible-role: button;
                accessible-label: Copy.tr("share.json", Copy.lang);
                accessible-expandable: true;
                accessible-expanded: root.show-json;
                accessible-action-default => {
                    root.show-json = !root.show-json;
                }
                json-focus := Focusable {
                    activate => {
                        root.show-json = !root.show-json;
                    }
                }
                clicked => {
                    json-focus.focus();
                    root.show-json = !root.show-json;
                }
                if json-focus.ring: Rectangle {
                    x: -3px;
                    width: parent.width + 6px;
                    border-radius: 4px;
                    border-width: 2px;
                    border-color: Theme.accent;
                }
                HorizontalLayout {
                    spacing: 8px;
                    // The fold's marker, drawn: the trimmed mono font has no triangle glyph.
                    Rectangle {
                        width: 8px;
                        Path {
                            width: 6px;
                            height: 8px;
                            x: 1px;
                            y: (parent.height - 8px) / 2;
                            viewbox-width: 6;
                            viewbox-height: 8;
                            commands: "M0 0 L6 4 L0 8 Z";
                            fill: Theme.chrome-soft;
                            transform-rotation: root.show-json ? 90deg : 0deg;
                            transform-origin: { x: 3px, y: 4px };
                        }
                    }
                    Text {
                        text: Copy.tr("share.json", Copy.lang);
                        font-family: Theme.text;
                        font-size: 13px;
                        font-weight: 800;
                        color: Theme.chrome-soft;
                        vertical-alignment: center;
                    }
                }
            }
            // The JSON scrolls in its own box: laid out in the panel, its long wrapped text made
            // the whole view taller and spread the parts above it apart.
            if root.show-json: Rectangle {
                height: 260px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.chrome-line;
                background: Theme.chrome-card;
                json-scroll := ScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-width: self.visible-width;
                    content-height: json-text.height + 24px;
                    json-text := Text {
                        x: 12px;
                        y: 12px;
                        width: json-scroll.visible-width - 24px;
                        text: root.json;
                        font-family: Theme.mono;
                        font-size: 11.5px;
                        color: Theme.chrome-soft;
                        wrap: char-wrap;
                    }
                }
            }
        }
        if root.problem != "": Text {
            text: root.problem;
            font-family: Theme.mono;
            font-size: 14px;
            font-weight: 600;
            color: Theme.accent;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: root.problem;
            accessible-live-region: assertive;
        }
    }
    if status == "done": VerticalLayout {
        spacing: 20px;
        // A tick, the news, and how long the link works.
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 30px;
                height: 30px;
                y: 2px;
                border-radius: 15px;
                background: Theme.btn;
                Path {
                    width: 14px;
                    height: 11px;
                    viewbox-width: 14;
                    viewbox-height: 11;
                    commands: "M1 5.5 L5 9.5 L13 1.5";
                    stroke: #FFFFFF;
                    stroke-width: 2.4px;
                    fill: transparent;
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: Copy.tr("share.done", Copy.lang);
                    font-family: Theme.display;
                    font-size: 24px;
                    font-weight: 800;
                    color: Theme.chrome-ink;
                    wrap: word-wrap;
                }
                Body { text: root.expires-text + (root.locked-note != "" ? " " + root.locked-note : ""); }
            }
        }
        // The link on a paper ticket, torn at the foot: the whole address, Copy and Open, and a QR code.
        Rectangle {
            Rectangle {
                height: parent.height - 7px;
                y: 0;
                background: Theme.paper;
                border-top-left-radius: 3px;
                border-top-right-radius: 3px;
                drop-shadow-offset-y: 3px;
                drop-shadow-blur: 10px;
                drop-shadow-color: #000000.with-alpha(0.22);
            }
            Path {
                y: parent.height - 7px;
                height: 7px;
                width: parent.width;
                viewbox-width: 320;
                viewbox-height: 7;
                fill: Theme.paper;
                commands: "M0 0 L7 7 L14 0 L21 7 L28 0 L35 7 L42 0 L49 7 L56 0 L63 7 L70 0 L77 7 L84 0 L91 7 L98 0 L105 7 L112 0 L119 7 L126 0 L133 7 L140 0 L147 7 L154 0 L161 7 L168 0 L175 7 L182 0 L189 7 L196 0 L203 7 L210 0 L217 7 L224 0 L231 7 L238 0 L245 7 L252 0 L259 7 L266 0 L273 7 L280 0 L287 7 L294 0 L301 7 L308 0 L315 7 L320 0 Z";
            }
            VerticalLayout {
                padding: 18px;
                padding-bottom: 24px;
                spacing: 12px;
                Text {
                    text: Copy.tr("share.link", Copy.lang).to-uppercase();
                    font-family: Theme.mono;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1.5px;
                    color: Theme.ink-soft;
                }
                Text {
                    text: root.link;
                    font-family: Theme.mono;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.ink;
                    wrap: char-wrap;
                    accessible-role: text;
                    accessible-label: Copy.tr("share.link", Copy.lang);
                    accessible-value: root.link;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    TicketButton {
                        text: Copy.tr("share.copy", Copy.lang);
                        label: Copy.tr("share.copy_link", Copy.lang);
                        clicked => {
                            root.copy-link();
                        }
                    }
                    TicketButton {
                        text: Copy.tr("share.open_short", Copy.lang);
                        label: Copy.tr("share.open", Copy.lang);
                        clicked => {
                            root.open-link();
                        }
                    }
                }
                // A dashed tear line, then the code, for a phone.
                Marks {
                    on: 3px;
                    period: 6px;
                    tint: Theme.rule;
                }
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 112px;
                        height: 112px;
                        background: #FFFFFF;
                        accessible-role: image;
                        accessible-label: Copy.tr("share.qr", Copy.lang);
                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: root.qr-size;
                            viewbox-height: root.qr-size;
                            commands: root.qr;
                            fill: #000000;
                        }
                    }
                    Text {
                        text: Copy.tr("share.qr_hint", Copy.lang);
                        font-family: Theme.mono;
                        font-size: 12px;
                        color: Theme.ink-soft;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        // The delete link: quieter, and the one to keep.
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.chrome-line;
            background: Theme.chrome-card;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                // Its heading and its Copy on one row, so Copy is in view without scrolling.
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel {
                        label: Copy.tr("share.delete_link", Copy.lang);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        horizontal-stretch: 0;
                        text: Copy.tr("share.copy", Copy.lang);
                        label: Copy.tr("share.copy_delete", Copy.lang);
                        clicked => {
                            root.copy-delete-link();
                        }
                    }
                }
                Text {
                    text: root.delete-link;
                    font-family: Theme.mono;
                    font-size: 12.5px;
                    color: Theme.chrome-ink;
                    wrap: char-wrap;
                    accessible-role: text;
                    accessible-label: Copy.tr("share.delete_link", Copy.lang);
                    accessible-value: root.delete-link;
                }
                Hint { text: Copy.tr("share.delete_keep", Copy.lang) + " " + Copy.tr("share.delete_note", Copy.lang); }
            }
        }
    }
}

// "My shared links": the links this PC made that haven't expired, each with Delete.
export component LinksView inherits VerticalLayout {
    in property <[LinkRow]> links;
    in property <string> status;
    in property <bool> failed;
    in property <bool> busy;
    callback delete(string);
    spacing: 16px;
    if links.length == 0: Body { text: Copy.tr("links.none", Copy.lang); }
    for l in links: VerticalLayout {
        spacing: 6px;
        Text {
            text: l.url;
            font-family: Theme.mono;
            font-size: 13px;
            font-weight: 600;
            color: Theme.chrome-ink;
            wrap: char-wrap;
        }
        HorizontalLayout {
            spacing: 12px;
            Hint {
                text: l.until;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                horizontal-stretch: 0;
                text: Copy.tr("links.delete", Copy.lang);
                enabled: !root.busy;
                clicked => {
                    root.delete(l.id);
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.chrome-line;
        }
    }
    if status != "": Text {
        text: status;
        font-family: Theme.mono;
        font-size: 13px;
        font-weight: 600;
        color: Theme.accent;
        wrap: word-wrap;
        accessible-role: text;
        accessible-label: status;
        accessible-live-region: polite;
    }
}
