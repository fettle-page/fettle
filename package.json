{
  "name": "fettle",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "zod": "^4.6.7",
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "gen:schema": "node packages/report-schema/scripts/generate.mjs",
    "gen:brain-types": "node packages/brain/scripts/gen-types.mjs",
    "dev:share": "npm run dev -w @fettle/worker",
    "kit": "node crates/fettle-collect/kit/build.mjs",
    "parity:goldens": "node crates/fettle-receipt/parity/generate.mts",
    "package:windows": "node apps/windows/packaging/build.mjs",
    "release:check": "node apps/windows/packaging/release.mjs check"
  }
}
