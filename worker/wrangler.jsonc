{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fettle",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  // Only on fettle.page: no workers.dev address or preview URLs that could serve share links elsewhere.
  "routes": [{ "pattern": "fettle.page", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../apps/web/dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/r/*", "/download", "/it/download"], "not_found_handling": "404-page" },
  // Created in R2's EU jurisdiction: shared receipts are stored only in EU data centres.
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "fettle-reports", "jurisdiction": "eu" }],
  // Per data centre, so these only bound cost and floods. The global password-guess cap is UnlockGuard.
  // namespace_id is unique across the whole Cloudflare account, so Fettle's are picked to stay clear of other projects.
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "59173", "simple": { "limit": 10, "period": 60 } },
    { "name": "UNLOCK_LIMITER", "namespace_id": "59174", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "UNLOCK_GUARD", "class_name": "UnlockGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UnlockGuard"] }],
  // Our own JSON logs only: invocation logs would record visitors' IPs and headers, and traces record R2 keys.
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } }
}
